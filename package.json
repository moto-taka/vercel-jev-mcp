{
  "name": "vercel-jev-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authenticated, stateless Hono MCP server for Jev through Vercel AI Gateway",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ai": "7.0.107",
    "hono": "^4.10.0",
    "mcp-handler": "2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.0",
    "typescript": "5.8.3"
  }
}
