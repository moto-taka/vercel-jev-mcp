# Generate on YOUR machine: openssl rand -hex 32
# Never commit a real value. This is NOT your Jev or AI Gateway key.
MCP_BEARER_TOKEN=

# Jev / TypeSafe key. Sent only to AI Gateway as request-scoped BYOK.
JEV_API_KEY=

# Recommended for explicit authentication. On Vercel, OIDC is also supported.
AI_GATEWAY_API_KEY=

# Optional: temporarily accept an old MCP token while rotating clients.
# MCP_BEARER_TOKEN_PREVIOUS=

# Optional exact browser origins (comma-separated). Native MCP clients need none.
# MCP_ALLOWED_ORIGINS=https://inspector.example.com

# Optional: total upstream deadline; 1000..55000 ms (default 20000).
# JEV_TIMEOUT_MS=20000
